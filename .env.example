# ============================================================
# STOCK BOT — ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# NEVER commit .env to git
#
# Minimum to run: the two ALPACA_* keys. Everything else is optional.
# ============================================================

# --- ALPACA (required — paper keys to start, live keys when ready) ---
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_PAPER=true

# --- CAPITAL ---
# broker  = use the money already in your Alpaca account (recommended)
# static  = use STARTING_CAPITAL below
CAPITAL_SOURCE=broker
STARTING_CAPITAL=1000

# --- CRYPTO EXCHANGE ---
# alpaca  = trade BTC/USD-style pairs 24/7 with your Alpaca account money
# binance = trade via CCXT/Binance (requires BINANCE_* keys below)
CRYPTO_EXCHANGE=alpaca
# Entries stay BTC-only until the strategy proves ~60 profitable days;
# then set false to trade the whole scanned universe (ETH/SOL/LTC too)
CRYPTO_BTC_ONLY=true

# --- STOCK UNIVERSE ---
# Blank = built-in full S&P 500 list. Or a comma-separated override:
# STOCK_UNIVERSE=AAPL,MSFT,NVDA
STOCK_UNIVERSE=

# --- STRATEGY MODES ---
# rotate    = Friday sells only positions that fell out of the fresh top
#             rankings; winners keep riding (holds over weekends).
# liquidate = sell everything Friday 3:45, flat all weekend.
STOCK_EXIT_MODE=rotate
# A held stock survives Friday rotation while it ranks inside this many names
ROTATION_KEEP_RANK=20
# regime = long while the trend is intact (enters mid-trend).
# cross  = only enter on a fresh EMA9/21 cross (misses running trends).
CRYPTO_ENTRY_MODE=regime
# Fraction of equity reserved for crypto so stock buys can't starve BTC.
# 0 disables the reservation (fully shared pot).
CRYPTO_ALLOCATION_PCT=0.25
# Calendar days of history the Sunday ML retrain pulls (more = more training
# examples). ~3 years is a good default for the weekly stock model.
ML_LOOKBACK_DAYS=1095
# Set to 1 to force CPU training even when a CUDA GPU is present.
ML_FORCE_CPU=

# --- RISK ---
# Reject a stock entry whose 60-day returns track an already-held name more
# closely than this (momentum picks cluster by sector). 1.0 disables.
MAX_POSITION_CORRELATION=0.85

# --- POLYGON.IO (optional — richer stock market data) ---
POLYGON_API_KEY=

# --- BINANCE (optional — only when CRYPTO_EXCHANGE=binance) ---
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# --- DATABASE (optional) ---
# Leave everything blank to use a local SQLite file (data_store/stockbot.db).
# Set DATABASE_URL for anything custom, or the DB_* fields for Postgres.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=stockbot
DB_USER=stockbot_user
DB_PASSWORD=

# --- TELEGRAM ALERTS (optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- WEB UI ---
WEB_HOST=0.0.0.0
WEB_PORT=8000
# Set a token to require "Authorization: Bearer <token>" on control endpoints
WEB_AUTH_TOKEN=

# --- BOT SETTINGS ---
ENVIRONMENT=paper
MAX_STOCK_POSITIONS=8
MAX_CRYPTO_POSITIONS=3
STOCK_RISK_PER_TRADE=0.02
CRYPTO_RISK_PER_TRADE=0.015
WEEKLY_DRAWDOWN_HALT_STOCK=-0.08
WEEKLY_DRAWDOWN_HALT_CRYPTO=-0.10
# Position floor. Auto-adapts down to 10% of account equity (never below
# $10), so a small account still trades without touching this.
MIN_POSITION_SIZE=50
